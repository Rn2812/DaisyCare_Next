{
  "name": "13 · Controle dos atendimentos (tempo, fila e atraso)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "daisy-atendimento",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "05e74e1c-774e-5dff-b1d8-06e397c694d0",
      "name": "Início/fim da consulta",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "8d6e1acf-a993-57c1-9cf4-d5e358ec1201"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.sla_min, ag.atraso_acumulado_min, ag.pacientes_aguardando FROM ops.sla_especialidade s JOIN ops.agenda_dia ag ON ag.especialidade = s.especialidade WHERE ag.medico_id = $1",
        "options": {
          "queryReplacement": "={{ [$json.body.medico_id] }}"
        }
      },
      "id": "c0b1aeb2-aa8f-5289-9ac4-88c1b4da9017",
      "name": "SLA e agenda do dia",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const ev = $('Início/fim da consulta').first().json.body;\nconst r = $input.first().json;\nconst dur = ev.duracao_min || 0;\nconst atraso = Math.max(0, (r.atraso_acumulado_min || 0) + Math.max(0, dur - r.sla_min));\nreturn [{ json: { ...ev, atraso_acumulado_min: atraso, aguardando: r.pacientes_aguardando, correlation_id: ev.correlation_id || ('ATD-' + Date.now().toString(36)) } }];"
      },
      "id": "71cfb1c4-0d63-5f47-b27e-c85ec9e52181",
      "name": "Atraso acumulado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.atraso_acumulado_min }}",
              "operation": "larger",
              "value2": 30
            }
          ]
        }
      },
      "id": "806658f6-5b28-5d52-b40d-62396dc76d39",
      "name": "Atraso > 30 min?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_BASE_URL }}/webhook/daisy-cobertura",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ correlation_id: $json.correlation_id, medico_id: $json.medico_id, motivo: \"atraso_acumulado\" }) }}",
        "options": {}
      },
      "id": "8b5a6e9e-5285-5d24-be71-49d0bd8faebf",
      "name": "Pedir cobertura (14)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        -90
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.atraso_acumulado_min }}",
              "operation": "larger",
              "value2": 20
            }
          ]
        }
      },
      "id": "57279a0c-e9a4-505c-983a-0920f69171a7",
      "name": "Atraso > 20 min?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
