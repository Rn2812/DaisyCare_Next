        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ correlation_id: $json.correlation_id, tipo: \"atraso_agenda\", minutos: $json.atraso_acumulado_min }) }}",
        "options": {}
      },
      "id": "6e41c9be-ce66-5817-8e6c-00a00bd1ba99",
      "name": "Reorganizar agenda + Daisy avisa quem espera",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
