      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit.evento_integracao (correlation_id, workflow, evento, payload) VALUES ($1,$2,$3,$4::jsonb)",
        "options": {
          "queryReplacement": "={{ [$json.correlation_id, '13_controle_atendimentos', 'atendimento_controlado', JSON.stringify($json)] }}"
        }
      },
      "id": "0787504c-ebd6-53d7-9a54-90a7b69af0eb",
