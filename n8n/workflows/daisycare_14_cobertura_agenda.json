        "method": "POST",
        "url": "={{ $env.N8N_BASE_URL }}/webhook/daisy-smartqueue-remarcar",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ correlation_id: $(\"Ranking de cobertura\").first().json.correlation_id, criterio: \"prioridade_assistencial\", alternativa: \"telemedicina\" }) }}",
        "options": {}
      },
      "id": "031c67b5-34a9-5c63-827a-d2103b7c275a",
      "name": "Telemedicina ou remarcação por prioridade (03)",
      "type": "n8n-nodes-base.httpRequest",
