      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit.evento_integracao (correlation_id, workflow, evento, payload) VALUES ($1,$2,$3,$4::jsonb)",
        "options": {
          "queryReplacement": "={{ [$json.correlation_id, '14_cobertura_agenda', 'cobertura_resolvida', JSON.stringify($json)] }}"
        }
      },
