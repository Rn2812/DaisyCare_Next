id] }}"}},"id":"c0b1aeb2-aa8f-5289-9ac4-88c1b4da9017","name":"SLA e agenda do dia","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[240,0]},{"parameters":{"jsCode":"const ev = $('Início/fim da consulta').first().json.body;\nconst r = $input.first().json;\nconst dur = ev.duracao_min || 0;\nconst atraso = Math.max(0, (r.atraso_acumulado_min || 0) + Math.max(0, dur - r.sla_min));\nreturn [{ json: { ...ev, atraso_acumulado_min: atraso, aguardando: r.pacientes_aguardando, correlation_id: ev.correlation_id || ('ATD-' + Date.now().toString(36)) } }];"},"id":"71cfb1c4-0d63-5f47-b27e-c85ec9e52181","name":"Atraso acumulado","type":"n8n-nodes-base.code","typeVersion":2,"position":[480,0]},{"parameters":{"conditions":{"number":[{"value1":"={{ $json.atraso_acumulado_min }}","operation":"larger","value2":30}]}},"id":"806658f6-5b28-5d52-b40d-62396dc76d39","name":"Atraso > 30 min?","type":"n8n-nodes-base.if","typeVersion":1,"position":[720,0]},{"parameters":{"method":"POST","url":"={{ $env.N8N_BASE_URL }}/webhook/daisy-cobertura","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ correlation_id: $json.correlation_id, medico_id: $json.medico_id, motivo: \"atraso_acumulado\" }) }}","options":{}},"id":"8b5a6e9e-5285-5d24-be71-49d0bd8faebf","name":"Pedir cobertura (14)","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[960,-90]},{"parameters":{"conditions":{"number":[{"value1":"={{ $json.atraso_acumulado_min }}","operation":"larger","value2":20}]}},"id":"57279a0c-e9a4-505c-983a-0920f69171a7","name":"Atraso > 20 min?","type":"n8n-nodes-base.if","typeVersion":1,"position":[960,90]},{"parameters":{"method":"POST","url":"={{ $env.N8N_BASE_URL }}/webhook/daisy-agente-aviso","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ correlation_id: $json.correlation_id, tipo: \"atraso_agenda\", minutos: $json.atraso_acumulado_min }) }}","options":{}},"id":"6e41c9be-ce66-5817-8e6c-00a00bd1ba99","name":"Reorganizar agenda + Daisy avisa quem espera","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1200,20]},{"parameters":{"operation":"executeQuery","query":"INSERT INTO audit.evento_integracao (correlation_id, workflow, evento, payload) VALUES ($1,$2,$3,$4::jsonb)","options":{"queryReplacement":"={{ [$json.correlation_id, '13_controle_atendimentos', 'atendimento_controlado', JSON.stringify($json)] }}"}},"id":"0787504c-ebd6-53d7-9a54-90a7b69af0eb","name":"Gravar evento","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[1200,200]}],"connections":{"Início/fim da consulta":{"main":[[{"node":"SLA e agenda do dia","type":"main","index":0}]]},"SLA e agenda do dia":{"main":[[{"node":"Atraso acumulado","type":"main","index":0}]]},"Atraso acumulado":{"main":[[{"node":"Atraso > 30 min?","type":"main","index":0}]]},"Atraso > 30 min?":{"main":[[{"node":"Pedir cobertura (14)","type":"main","index":0}],[{"node":"Atraso > 20 min?","type":"main","index":0}]]},"Atraso > 20 min?":{"main":[[{"node":"Reorganizar agenda + Daisy avisa quem espera","type":"main","index":0}],[{"node":"Gravar evento","type":"main","index":0}]]},"Reorganizar agenda + Daisy avisa quem espera":{"main":[[{"node":"Gravar evento","type":"main","index":0}]]},"Pedir cobertura (14)":{"main":[[{"node":"Gravar evento","type":"main","index":0}]]}},"active":false,"settings":{"executionOrder":"v1"},"tags":[{"name":"DaisyCare"},{"name":"modelo-ouro"}],"meta":{"descricao":"Cronometra cada consulta contra o SLA da especialidade e reorganiza a agenda quando o atraso acumula.","aviso":"Simulação do MVP. Vincule suas credenciais (PostgreSQL) e defina a variável N8N_BASE_URL. Sem CPF nem dados clínicos."}}},{"file":"daisycare_14_cobertura_agenda.json","name":"14 · Cobertura de agenda (ranking, convite e reatribuição)","json":{"name":"14 · Cobertura de agenda (ranking, convite e reatribuição)","nodes":[{"parameters":{"httpMethod":"POST","path":"daisy-cobertura","responseMode":"onReceived","options":{}},"id":"c529991a-b399-5de7-9276-b3632799726b","name":"Gatilho de cobertura","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,0],"webhookId":"83bc4bc3-b63d-5068-962f-ce878eb07f6c"},{"parameters":{"operation":"executeQuery","query":"SELECT medico_id, eta_min, carga_pacientes, unidade FROM ops.escala WHERE status = 'sobreaviso' AND especialidade = $1","options":{"queryReplacement":"={{ [$json.body.especialidade] }}"}},"id":"92172cc8-cd7c-5c04-aa1b-fdb895b33cde","name":"Candidatos em sobreaviso","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[240,0]},{"parameters":{"jsCode":"const g = $('Gatilho de cobertura').first().json.body;\nconst r = $input.all().map(i => i.json).map(c => ({\n  ...c, score: Math.round(100 - c.eta_min * 1.2 - (c.carga_pacientes / 2) * 3 + (c.unidade === g.unidade ? 15 : 0))\n})).sort((a, b) => b.score - a.score);\nconst top = r[0] || null;\nreturn [{ json: { ...g, candidato: top, ranking: r.slice(0, 3), tem_candidato: !!top } }];"},"id":"8a32331e-854c-5297-8e0e-95608bcaa775","name":"Ranking de cobertura","type":"n8n-nodes-base.code","typeVersion":2,"position":[480,0]},{"parameters":{"conditions":{"string":[{"value1":"={{ $json.tem_candidato }}","operation":"equal","value2":"true"}]}},"id":"499db8c2-20b1-5a09-8c7a-036fb02eedf8","name":"Há candidato?","type":"n8n-nodes-base.if","typeVersion":1,"position":[720,0]},{"parameters":{"method":"POST","url":"={{ $env.N8N_BASE_URL }}/webhook/daisy-convite-medico","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ correlation_id: $json.correlation_id, medico_id: $json.candidato.medico_id, janela_min: 5 }) }}","options":{}},"id":"975da921-9f15-5b40-8074-0aca5faf650e","name":"Convidar profissional (app + WhatsApp)","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[960,-90]},{"parameters":{"resume":"timeInterval","amount":5,"unit":"minutes"},"id":"d8c5745a-e9da-581c-b390-a7237bee8fdc","name":"Aguardar 5 min","type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[1200,-90]},{"pa